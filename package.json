{
  "name": "halo-charon-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Halo Charon POC \u2014 simulation core + VAT rendering validation harness",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "headless": "node sim/headless.js",
    "determinism": "node sim/determinism-check.js",
    "physics": "node engine/physics/physics-check.mjs",
    "ragdoll": "node engine/physics/ragdoll-check.mjs",
    "melee": "node sim/melee-check.mjs",
    "commands": "node sim/command-check.js",
    "multiplayer": "node multiplayer/protocol-check.mjs",
    "check": "npm run multiplayer && npm run determinism && npm run physics && npm run ragdoll && npm run melee && npm run commands",
    "vendor:peerd": "node scripts/vendor-peerd-browser.mjs",
    "build:dwapp": "node scripts/build-dwapp.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
